code = "shader_type spatial;
render_mode blend_add, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D depth_tex_frg_21 : hint_depth_texture;
uniform float UV_Scale = 3.0;
uniform sampler2D tex_frg_3;
uniform sampler2D tex_frg_4;
uniform float Highlight : hint_range(0.0, 1.0) = 0.5;
uniform float Main : hint_range(0.0, 1.0) = 0.30000001192093;



void fragment() {
	float n_out21p0;
// ProximityFade:21
	float n_in21p0 = 1.00000;
	{
		float __depth_tex = texture(depth_tex_frg_21, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out21p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_in21p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatFunc:22
	float n_out22p0 = 1.0 - n_out21p0;


// FloatParameter:11
	float n_out11p0 = UV_Scale;


// UVFunc:9
	vec2 n_in9p2 = vec2(0.00000, 0.00000);
	vec2 n_out9p0 = (UV - n_in9p2) * vec2(n_out11p0) + n_in9p2;


// Input:8
	float n_out8p0 = TIME;


// UVFunc:6
	vec2 n_in6p1 = vec2(0.00500, -0.00500);
	vec2 n_out6p0 = vec2(n_out8p0) * n_in6p1 + n_out9p0;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out6p0);


// UVFunc:10
	vec2 n_in10p2 = vec2(0.00000, 0.00000);
	vec2 n_out10p0 = (UV - n_in10p2) * vec2(n_out11p0) + n_in10p2;


// UVFunc:7
	vec2 n_in7p1 = vec2(0.01000, 0.00500);
	vec2 n_out7p0 = vec2(n_out8p0) * n_in7p1 + n_out10p0;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, n_out7p0);


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out3p0.xyz) * vec3(n_out4p0.xyz);


// FloatParameter:13
	float n_out13p0 = Highlight;


// Compare:12
	bool n_out12p0 = n_out5p0.x >= n_out13p0;


// VectorOp:14
	vec3 n_out14p0 = vec3(n_out12p0 ? 1.0 : 0.0) * n_out5p0;


// FloatParameter:17
	float n_out17p0 = Main;


// Compare:16
	bool n_out16p0 = n_out5p0.x <= n_out17p0;


// VectorOp:18
	vec3 n_out18p0 = n_out5p0 * vec3(n_out16p0 ? 1.0 : 0.0);


// VectorOp:15
	vec3 n_out15p0 = n_out14p0 + n_out18p0;


// VectorOp:23
	vec3 n_out23p0 = vec3(n_out22p0) + n_out15p0;


// FloatConstant:25
	float n_out25p0 = 0.080000;


// VectorOp:26
	vec3 n_out26p0 = n_out15p0 + vec3(n_out25p0);


// Output:0
	ALBEDO = n_out23p0;
	ALPHA = n_out26p0.x;


}
"
