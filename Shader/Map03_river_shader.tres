[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, depth_test_default, cull_disabled, diffuse_toon, specular_toon;

uniform float Wave_Speed = 0.10000000149012;
uniform sampler2D tex_vtx_4;
uniform sampler2D depth_tex_frg_12 : hint_depth_texture;
uniform float UV_Scale = 3.0;
uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_3;
uniform float Highlight : hint_range(0.0, 1.0) = 0.5;
uniform float Main : hint_range(0.0, 1.0) = 0.30000001192093;
uniform sampler2D tex_frg_24;



void vertex() {
// Input:9
	float n_out9p0 = TIME;


// FloatParameter:11
	float n_out11p0 = Wave_Speed;


// VectorOp:10
	vec2 n_out10p0 = vec2(n_out9p0) * vec2(n_out11p0);


// UVFunc:8
	vec2 n_in8p1 = vec2(2.00000, 2.00000);
	vec2 n_out8p0 = n_out10p0 * n_in8p1 + UV;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_vtx_4, n_out8p0);


// VectorOp:7
	vec3 n_in7p1 = vec3(0.00000, 0.00100, 0.00000);
	vec3 n_out7p0 = vec3(n_out4p0.xyz) * n_in7p1;


// Input:6
	vec3 n_out6p0 = VERTEX;


// VectorOp:5
	vec3 n_out5p0 = n_out7p0 + n_out6p0;


// Output:0
	VERTEX = n_out5p0;


}

void fragment() {
	float n_out12p0;
// ProximityFade:12
	float n_in12p0 = 0.02000;
	{
		float __depth_tex = texture(depth_tex_frg_12, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(vec3(SCREEN_UV, __depth_tex) * 2.0 - 1.0, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out12p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_in12p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatFunc:18
	float n_out18p0 = 1.0 - n_out12p0;


// FloatParameter:8
	float n_out8p0 = UV_Scale;


// UVFunc:23
	vec2 n_in23p2 = vec2(0.00000, 0.00000);
	vec2 n_out23p0 = (UV - n_in23p2) * vec2(n_out8p0) + n_in23p2;


// Input:6
	float n_out6p0 = TIME;


// UVFunc:5
	vec2 n_in5p1 = vec2(0.00000, -0.08000);
	vec2 n_out5p0 = vec2(n_out6p0) * n_in5p1 + n_out23p0;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out5p0);


// UVFunc:7
	vec2 n_in7p2 = vec2(0.00000, 0.00000);
	vec2 n_out7p0 = (UV - n_in7p2) * vec2(n_out8p0) + n_in7p2;


// UVFunc:22
	vec2 n_in22p1 = vec2(0.00000, 0.05000);
	vec2 n_out22p0 = vec2(n_out6p0) * n_in22p1 + n_out7p0;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out22p0);


// VectorOp:4
	vec3 n_out4p0 = vec3(n_out2p0.xyz) * vec3(n_out3p0.xyz);


// FloatParameter:10
	float n_out10p0 = Highlight;


// Compare:9
	bool n_out9p0 = n_out4p0.x >= n_out10p0;


// VectorOp:11
	vec3 n_out11p0 = vec3(n_out9p0 ? 1.0 : 0.0) * n_out4p0;


// FloatParameter:21
	float n_out21p0 = Main;


// Compare:20
	bool n_out20p0 = n_out4p0.x <= n_out21p0;


// VectorOp:19
	vec3 n_out19p0 = n_out4p0 * vec3(n_out20p0 ? 1.0 : 0.0);


// VectorOp:15
	vec3 n_out15p0 = n_out11p0 + n_out19p0;


// VectorOp:17
	vec3 n_out17p0 = vec3(n_out18p0) + n_out15p0;


// FloatConstant:13
	float n_out13p0 = 0.400000;


// VectorOp:16
	vec3 n_out16p0 = n_out15p0 + vec3(n_out13p0);


// Texture2D:24
	vec4 n_out24p0 = texture(tex_frg_24, UV);


// MultiplyAdd:14
	vec3 n_out14p0 = (n_out17p0 * n_out16p0) + vec3(n_out24p0.xyz);


// Output:0
	ALBEDO = n_out14p0;


}
"
