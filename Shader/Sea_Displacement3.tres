[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, depth_test_default, cull_disabled, diffuse_toon, specular_toon;

uniform float Wave_Speed = 0.10000000149012;
uniform sampler2D tex_vtx_4;
uniform sampler2D depth_tex_frg_13 : hint_depth_texture;
uniform float UV_Scale = 3.0;
uniform sampler2D tex_frg_3;
uniform sampler2D tex_frg_4;
uniform float Highlight : hint_range(0.0, 1.0) = 0.5;
uniform float Main : hint_range(0.0, 1.0) = 0.30000001192093;
uniform sampler2D tex_frg_2;



void vertex() {
// Input:9
	float n_out9p0 = TIME;


// FloatParameter:11
	float n_out11p0 = Wave_Speed;


// VectorOp:10
	vec2 n_out10p0 = vec2(n_out9p0) * vec2(n_out11p0);


// UVFunc:8
	vec2 n_in8p1 = vec2(2.00000, 2.00000);
	vec2 n_out8p0 = n_out10p0 * n_in8p1 + UV;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_vtx_4, n_out8p0);


// VectorOp:7
	vec3 n_in7p1 = vec3(0.00000, 0.00100, 0.00000);
	vec3 n_out7p0 = vec3(n_out4p0.xyz) * n_in7p1;


// Input:6
	vec3 n_out6p0 = VERTEX;


// VectorOp:5
	vec3 n_out5p0 = n_out7p0 + n_out6p0;


// Output:0
	VERTEX = n_out5p0;


}

void fragment() {
	float n_out13p0;
// ProximityFade:13
	float n_in13p0 = 0.00600;
	{
		float __depth_tex = texture(depth_tex_frg_13, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out13p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_in13p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatFunc:19
	float n_out19p0 = 1.0 - n_out13p0;


// FloatParameter:9
	float n_out9p0 = UV_Scale;


// UVFunc:24
	vec2 n_in24p2 = vec2(0.00000, 0.00000);
	vec2 n_out24p0 = (UV - n_in24p2) * vec2(n_out9p0) + n_in24p2;


// Input:7
	float n_out7p0 = TIME;


// UVFunc:6
	vec2 n_in6p1 = vec2(-0.01000, -0.01000);
	vec2 n_out6p0 = vec2(n_out7p0) * n_in6p1 + n_out24p0;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out6p0);


// UVFunc:8
	vec2 n_in8p2 = vec2(0.00000, 0.00000);
	vec2 n_out8p0 = (UV - n_in8p2) * vec2(n_out9p0) + n_in8p2;


// UVFunc:23
	vec2 n_in23p1 = vec2(0.03000, 0.00000);
	vec2 n_out23p0 = vec2(n_out7p0) * n_in23p1 + n_out8p0;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, n_out23p0);


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out3p0.xyz) * vec3(n_out4p0.xyz);


// FloatParameter:11
	float n_out11p0 = Highlight;


// Compare:10
	bool n_out10p0 = n_out5p0.x >= n_out11p0;


// VectorOp:12
	vec3 n_out12p0 = vec3(n_out10p0 ? 1.0 : 0.0) * n_out5p0;


// FloatParameter:22
	float n_out22p0 = Main;


// Compare:21
	bool n_out21p0 = n_out5p0.x <= n_out22p0;


// VectorOp:20
	vec3 n_out20p0 = n_out5p0 * vec3(n_out21p0 ? 1.0 : 0.0);


// VectorOp:16
	vec3 n_out16p0 = n_out12p0 + n_out20p0;


// VectorOp:18
	vec3 n_out18p0 = vec3(n_out19p0) + n_out16p0;


// FloatConstant:14
	float n_out14p0 = 0.400000;


// VectorOp:17
	vec3 n_out17p0 = n_out16p0 + vec3(n_out14p0);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// MultiplyAdd:15
	vec3 n_out15p0 = fma(n_out18p0, n_out17p0, vec3(n_out2p0.xyz));


// Output:0
	ALBEDO = n_out15p0;


}
